# 复制为 .env 后按需修改
XHSNOTE_TIMEOUT=20
XHSNOTE_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0.0.0 Safari/537.36"
XHSNOTE_OUTPUT_DIR=output
XHSNOTE_LOG_LEVEL=INFO
XHSNOTE_SAVE_LOG=false
XHSNOTE_LOG_DIR=logs
# XHSNOTE_INPUT_FILE=notes_url.txt
# API settings
XHSNOTE_API_HOST=127.0.0.1
XHSNOTE_API_PORT=8000
XHSNOTE_API_RELOAD=true
XHSNOTE_API_CORS_ORIGINS=http://localhost:5173
# XHSNOTE_API_ENABLE_STATIC=true
# XHSNOTE_API_STATIC_DIR=web/dist
